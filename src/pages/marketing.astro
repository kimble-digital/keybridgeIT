        <div class="anchbox">
          <label class="srch">
            <span class="sr-only">Filter copy blocks</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="srch-ic"
              ><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"
              ></circle><path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2"
                stroke-linecap="round"></path></svg
            >
            <input
              type="search"
              id="packSearch"
              placeholder="Filter blocks…"
              autocomplete="off"
              spellcheck="false"
            />
          </label>
          <p class="hits" id="packHits" hidden></p>
          <nav class="anchlist">
            {
              navItems.map((n) => (
                <a href={`#${n.id}`} data-anch={n.id}>
                  <span class="anum">{n.num}</span>
                  {n.label}
                </a>
              ))
            }
          </nav>
          <p class="anchnote">
            Blocks are editable in place. Counts update as you type. Nothing is saved, so refresh
            to reset everything.
          </p>
        </div>
      </aside>

      <!-- ---------- Content ---------- -->
      <div class="packbody">
        <!-- 1. Approved facts -->
        <section class="psec" id="facts" data-sec="facts">
          <h2 class="psec-h"><span class="pnum">1</span>Approved facts</h2>
          <p class="psec-intro">The only numbers to use.</p>

          <div class="tablewrap">
            <table class="facts">
              <thead><tr><th>Fact</th><th>Approved wording</th></tr></thead>
              <tbody>
                {facts.map(([k, v]) => (
                  <tr>
                    <td class="fk">{k}</td>
                    <td>{v}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="flagbox">
            <h3>Flagged before publishing anywhere external</h3>
            <ul>{flags.map((f) => <li>{f}</li>)}</ul>
          </div>
        </section>

        <!-- 2-8. Copy sections -->
        {
          sections.map((s) => (
            <section class="psec" id={s.id} data-sec={s.id}>
              <h2 class="psec-h">
                <span class="pnum">{s.num}</span>
                {s.title}
              </h2>
              {s.intro && <p class="psec-intro">{s.intro}</p>}

              {s.groups.map((g) => (
                <div class="pgroup">
                  {g.title && <h3 class="pgroup-h">{g.title}</h3>}
                  <div class="blocks">
                    {g.blocks.map((b) => (
                      <article
                        class={`cblock v-${s.accent}`}
                        data-block
                        data-search={`${s.title} ${g.title ?? ""} ${b.label} ${b.meta ?? ""} ${b.paras.join(" ")}`.toLowerCase()}
                      >
                        <header class="cbhead">
                          <div class="cbtitle">
                            <h4>{b.label}</h4>
                            {b.meta && <span class="cbmeta">{b.meta}</span>}
                          </div>
                          <div class="cbtools">
                            <span
                              class="counts"
                              data-counts
                              data-limit={b.limit ?? ""}
                              aria-live="polite"
                            />
                            <button class="cbtn" type="button" data-copy>
                              <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect
                                  x="9"
                                  y="9"
                                  width="11"
                                  height="11"
                                  rx="2"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                />
                                <path
                                  d="M5 15V6a2 2 0 0 1 2-2h9"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                />
                              </svg>
                              <span data-copylabel>Copy</span>
                            </button>
                          </div>
                        </header>
                        <div
                          class="cbtext"
                          data-text
                          contenteditable="true"
                          spellcheck="false"
                          role="textbox"
                          aria-multiline="true"
                          aria-label={`${b.label} copy, editable`}
                        >
                          {b.paras.map((p) => (
                            <p>{p}</p>
                          ))}
                        </div>
                        {b.note && <p class="cbnote">{b.note}</p>}
                      </article>
                    ))}
                  </div>
                </div>
              ))}
            </section>
          ))
        }

        <!-- 9. Guardrails -->
        <section class="psec" id="guardrails" data-sec="guardrails">
          <h2 class="psec-h"><span class="pnum">9</span>Guardrails</h2>
          <div class="rails">
            {
              guardrails.map(([k, v]) => (
                <div class="rail">
                  <span class="railk">{k}</span>
                  <p>{v}</p>
                </div>
              ))
            }
          </div>
        </section>

        <p class="noresults" id="packNone" hidden>
          Nothing matches that. Clear the filter to see everything again.
        </p>
      </div>
    </div>
  </section>
</Base>

