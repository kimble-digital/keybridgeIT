<script is:inline>
  (function () {
    var blocks = Array.prototype.slice.call(document.querySelectorAll("[data-block]"));
    if (!blocks.length) return;

    /* ---- plain text of a block, paragraphs separated by blank lines ---- */
    function plain(block) {
      var host = block.querySelector("[data-text]");
      var ps = host.querySelectorAll("p");
      var parts = [];
      if (ps.length) {
        Array.prototype.forEach.call(ps, function (p) {
          parts.push(p.innerText.replace(/\s+/g, " ").trim());
        });
      } else {
        parts.push(host.innerText.replace(/\s+/g, " ").trim());
      }
      return parts
        .filter(function (t) {
          return t.length;
        })
        .join("\n\n");
    }

    /* ---- live counters ---- */
    function count(block) {
      var el = block.querySelector("[data-counts]");
      if (!el) return;
      var t = plain(block);
      var words = t.split(/\s+/).filter(Boolean).length;
      var chars = t.length;
      var limit = parseInt(el.getAttribute("data-limit"), 10);
      el.textContent = words + "w · " + chars + "c";
      if (limit) {
        el.textContent = words + "w · " + chars + "/" + limit + "c";
        el.classList.toggle("over", chars > limit);
      }
    }
    blocks.forEach(function (b) {
      count(b);
      var t = b.querySelector("[data-text]");
      t.addEventListener("input", function () {
        count(b);
      });
      /* paste as plain text so pasted formatting never lands in a block */
      t.addEventListener("paste", function (e) {
        e.preventDefault();
        var txt = (e.clipboardData || window.clipboardData).getData("text");
        document.execCommand("insertText", false, txt);
      });
    });

    /* ---- copy ---- */
    function flash(btn) {
      var label = btn.querySelector("[data-copylabel]");
      var was = label.textContent;
      btn.classList.add("done");
      label.textContent = "Copied";
      setTimeout(function () {
        btn.classList.remove("done");
        label.textContent = was;
      }, 1400);
    }
    function fallbackCopy(text) {
      var ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand("copy");
      } catch (err) {}
      document.body.removeChild(ta);
    }
    document.addEventListener("click", function (e) {
      var btn = e.target.closest ? e.target.closest("[data-copy]") : null;
      if (!btn) return;
      var block = btn.closest("[data-block]");
      var text = plain(block);
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(
          function () {
            flash(btn);
          },
          function () {
            fallbackCopy(text);
            flash(btn);
          },
        );
      } else {
        fallbackCopy(text);
        flash(btn);
      }
    });

    /* ---- search filter ---- */
    var input = document.getElementById("packSearch");
    var hits = document.getElementById("packHits");
    var none = document.getElementById("packNone");
    var secs = Array.prototype.slice.call(document.querySelectorAll("[data-sec]"));

    function filter() {
      var q = input.value.trim().toLowerCase();
      if (!q) {
        blocks.forEach(function (b) {
          b.hidden = false;
        });
        secs.forEach(function (s) {
          s.hidden = false;
        });
        document.querySelectorAll(".pgroup").forEach(function (g) {
          g.hidden = false;
        });
        hits.hidden = true;
        none.hidden = true;
        return;
      }
      var shown = 0;
      blocks.forEach(function (b) {
        var match = b.getAttribute("data-search").indexOf(q) !== -1;
        b.hidden = !match;
        if (match) shown++;
      });
      /* hide empty groups, then empty sections */
      document.querySelectorAll(".pgroup").forEach(function (g) {
        g.hidden = !g.querySelector("[data-block]:not([hidden])");
      });
      secs.forEach(function (s) {
        if (s.id === "facts" || s.id === "guardrails") {
          s.hidden = true;
          return;
        }
        s.hidden = !s.querySelector("[data-block]:not([hidden])");
      });
      hits.hidden = false;
      hits.textContent = shown + (shown === 1 ? " block" : " blocks");
      none.hidden = shown > 0;
    }
    input.addEventListener("input", filter);
    input.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        input.value = "";
        filter();
      }
    });

    /* ---- scroll spy ---- */
    var links = Array.prototype.slice.call(document.querySelectorAll("[data-anch]"));
    var byId = {};
    links.forEach(function (a) {
      byId[a.getAttribute("data-anch")] = a;
    });
    if ("IntersectionObserver" in window) {
      /* the narrow layout puts a sticky filter bar under the fixed nav, so the
         "what am I looking at" line sits much further down the viewport */
      var narrow = window.matchMedia("(max-width: 980px)");
      var obs = null;
      var visible = {};
      var lastOn = null;

      function markActive(id) {
        if (id === lastOn) return;
        lastOn = id;
        links.forEach(function (a) {
          var on = a.getAttribute("data-anch") === id;
          a.classList.toggle("on", on);
          /* keep the active chip in view in the horizontal strip */
          if (on && narrow.matches && a.parentNode.scrollWidth > a.parentNode.clientWidth) {
            var l = a.offsetLeft - 12;
            a.parentNode.scrollTo ? a.parentNode.scrollTo({ left: l, behavior: "smooth" })
                                  : (a.parentNode.scrollLeft = l);
          }
        });
      }

      function build() {
        if (obs) obs.disconnect();
        visible = {};
        obs = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              visible[en.target.id] = en.isIntersecting;
            });
            var current = null;
            secs.forEach(function (s) {
              if (!current && visible[s.id] && !s.hidden) current = s.id;
            });
            if (current) markActive(current);
          },
          {
            rootMargin: (narrow.matches ? -206 : -84) + "px 0px -60% 0px",
            threshold: 0,
          },
        );
        secs.forEach(function (s) {
          obs.observe(s);
        });
      }
      build();
      narrow.addEventListener
        ? narrow.addEventListener("change", build)
        : narrow.addListener(build);
    }
  })();
</script>
