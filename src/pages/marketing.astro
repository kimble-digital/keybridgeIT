---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

export const prerender = true;

/* ============================================================
   /marketing — Boilerplate & Profile Copy Pack
   Internal reference page. noindex, not in nav, not in sitemap.
   Source of truth: "Keybridge IT: Boilerplate & Profile Copy Pack (v1)"
   (Google Doc). Update both together.
   ============================================================ */

type Block = {
  id: string;
  label: string;
  meta?: string;
  limit?: number;
  note?: string;
  paras: string[];
};
type Group = { title?: string; blocks: Block[] };
type Section = {
  id: string;
  num: string;
  title: string;
  accent: string;
  intro?: string;
  groups: Group[];
};

const facts: [string, string][] = [
  ["Age", "15 years / fifteen years established"],
  ["Team", "25 specialists"],
  ["Clients", "200 organisations"],
  ["Devices", "5,000 devices"],
  ["Servers", "roughly 100 to 120 servers"],
  ["Reviews", "130+ five-star reviews"],
  ["Security record", "over a decade with no client ransomware breach"],
  ["Response", "critical issues: 20-minute response, 2-hour resolution"],
  ["Location", "London-based, supporting clients UK-wide"],
  [
    "Support model",
    "UK help desk in business hours, English-speaking colleagues in the Philippines overnight, real people around the clock",
  ],
  [
    "Accreditations",
    "Microsoft Solutions Partner · Cyber Essentials · Cyber Essentials Plus · ISO 27001:2022 · APSCo Trusted Partner",
  ],
];

const flags: string[] = [
  `"over a decade with no client ransomware breach". Andy to confirm the exact number of years before any specific figure is used.`,
  `"£4m turnover". In the foundation doc, deliberately kept out of public boilerplate. Use only in tender and investor contexts where turnover is asked for.`,
  `"more than 30 recruitment businesses". Derived from the 32 recruitment logos in the welcome pack. Confirm with Andy before use in press.`,
];

