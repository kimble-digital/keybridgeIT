const guardrails: [string, string][] = [
  [
    "Never write",
    "world-class, best-in-class, cutting-edge, seamless, robust, leverage, synergy, holistic, empower, unlock, elevate, harness, streamline, turnkey, ecosystem, on a mission, fast-growing, next-generation, reimagine, game-changing, revolutionise, the future of, disrupt.",
  ],
  [
    "Never use",
    `em-dashes. "Not just X, but Y." Rule-of-three headers everywhere. "In today's fast-paced digital landscape." "Whether you're X or Y."`,
  ],
  [
    "Never name",
    "engineers or support staff. It invites poaching. Convey personal service through the account-manager promise instead.",
  ],
  [
    "Never imply",
    "that every overnight agent is UK-based, that Keybridge has moved on from recruitment, or that AI runs without human oversight.",
  ],
  [
    "Always",
    "British spelling, contractions on, one concrete fact or number per claim. Then run the five-second test: could a competitor paste this exact sentence onto their site and have it be equally true? If yes, make it specifically Keybridge.",
  ],
];

const navItems = [
  { id: "facts", label: "Approved facts", num: "1" },
  ...sections.map((s) => ({ id: s.id, label: s.title, num: s.num })),
  { id: "guardrails", label: "Guardrails", num: "9" },
];

const blockCount = sections.reduce(
  (n, s) => n + s.groups.reduce((m, g) => m + g.blocks.length, 0),
  0,
);
