---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { company } from "../data/site";
const updated = new Date().toLocaleDateString('en-GB', { year:'numeric', month:'long', day:'numeric' });
const cookies = [
  { name: "_ga", provider: "Google Analytics", purpose: "Distinguishes unique visitors so we can measure website usage.", duration: "2 years" },
  { name: "_ga_*", provider: "Google Analytics", purpose: "Maintains analytics session state for our specific property.", duration: "2 years" },
  { name: "_gid", provider: "Google Analytics", purpose: "Distinguishes visitors over a short period (may appear on some configurations).", duration: "24 hours" },
];
---
<Base title="Cookie Policy — Keybridge IT" description="How the Keybridge IT website uses cookies and similar technologies, and how to manage them.">
  <PageHero eyebrow="LEGAL" title="Cookie Policy" lead={`Last updated ${updated}. This policy explains the cookies we use and how to control them.`} />
  <section class="section"><div class="wrap legal">

    <p>This policy explains how {company.name} ("we", "us" or "our") uses cookies and similar technologies on our website, and how you can manage them. It should be read alongside our <a href="/privacy">Privacy Policy</a>.</p>

    <h2>What cookies are</h2>
    <p>Cookies are small text files placed on your device when you visit a website. They are widely used to make websites work, to remember your preferences and to provide information to site owners about how their site is used. Some cookies are essential, while others, such as analytics cookies, are optional.</p>

    <h2>How we use cookies</h2>
    <p>Our website is a static, content-only site. We do not use cookies for advertising, profiling or tracking you across other websites. The only non-essential cookies we use are set by Google Analytics, which helps us understand how visitors use the site so we can improve it. You can opt out of these cookies at any time using the methods set out below.</p>

    <div class="tablewrap">
      <table>
        <thead><tr><th>Cookie</th><th>Provider</th><th>Purpose</th><th>Duration</th></tr></thead>
        <tbody>
          {cookies.map((c) => (
            <tr><td><code>{c.name}</code></td><td>{c.provider}</td><td>{c.purpose}</td><td>{c.duration}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <p>Google Analytics may collect information such as a truncated IP address, the pages you visit, your approximate location, and your device and browser type. This information is aggregated and used for statistical purposes. For more detail, see Google's privacy and cookie information at policies.google.com.</p>

    <h2>Managing your cookies</h2>
    <p>You can opt out of analytics cookies at any time. You can:</p>
    <ul>
      <li>change or block cookies through your browser settings, although blocking some cookies may affect how websites function;</li>
      <li>install the Google Analytics Opt-out Browser Add-on, available at tools.google.com/dlpage/gaoptout, to prevent your data being used by Google Analytics; and</li>
      <li>use your browser's private or incognito mode to limit the storage of cookies.</li>
    </ul>
    <p>Most browsers also allow you to delete cookies that have already been stored. Help pages for the major browsers explain how to do this.</p>

    <h2>Changes to this policy</h2>
    <p>We may update this policy if we add or change the technologies we use. The date at the top of this page shows when it was last revised.</p>

    <h2>Contact us</h2>
    <p>If you have any questions about our use of cookies, please contact us at {company.email}.</p>

  </div></section>
</Base>
<style>
  .legal{max-width:72ch}
  .legal h2{font-size:1.4rem;margin:38px 0 12px;color:var(--ink, #fff)}
  .legal p{color:var(--muted);line-height:1.75;margin-bottom:14px}
  .legal ul{margin:0 0 16px 22px;color:var(--muted);line-height:1.75}
  .legal li{margin-bottom:8px}
  .legal a{color:var(--teal, #1fb6c9);text-decoration:underline;text-underline-offset:2px}
  .tablewrap{overflow-x:auto;margin:8px 0 18px}
  .legal table{width:100%;border-collapse:collapse;font-size:14px;min-width:520px}
  .legal th,.legal td{text-align:left;padding:12px 14px;border-bottom:1px solid var(--line);color:var(--muted);vertical-align:top}
  .legal th{color:#e7e7ee;font-family:var(--display, sans-serif);font-size:12px;letter-spacing:.04em;text-transform:uppercase}
  .legal code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;color:#e7e7ee}
</style>
