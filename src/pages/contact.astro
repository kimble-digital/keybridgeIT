---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
const AC = "var(--purple)";
const EMAIL = "info@keybridgeit.com";
const ADDRESS = "75 King William Street, London EC4N 7BE";
const MAP_SRC = "https://www.google.com/maps?q=75+King+William+Street,+London+EC4N+7BE&output=embed";
const MAP_LINK = "https://www.google.com/maps/search/?api=1&query=75%20King%20William%20Street%2C%20London%20EC4N%207BE";
---
<Base title="Contact — Keybridge IT" description="Get in touch with Keybridge IT Solutions, in the heart of the City of London. UK-based support with 24/7 cover.">

  <section class="con-hero">
    <div class="wrap con-grid">

      <div class="con-intro reveal">
        <div class="eyebrow" style="margin-bottom:18px"><span class="dot" style={`background:${AC};box-shadow:0 0 12px ${AC}`}></span> CONTACT</div>
        <h1 class="con-h1">How can we help?</h1>
        <p class="con-lead">We're based in the heart of the City of London and easy to reach. Drop us a message below, or use the details here, and a real person will come back to you.</p>
      </div>

      <div class="con-formblock reveal">
        <h2 class="con-form-h2">Send us a message</h2>
        <ContactForm subject="General enquiry" accent={AC} cta="Send message" variant="simple" />
      </div>

      <div class="con-detailsblock reveal">
        <div class="con-details">
          <div><span class="con-label">Email</span><a href={`mailto:${EMAIL}`}>{EMAIL}</a></div>
          <div><span class="con-label">Office</span>{ADDRESS}</div>
          <div><span class="con-label">Hours</span>UK team in business hours, with overnight and weekend cover. 24/7 for clients.</div>
        </div>
        <p class="con-aside">Already a client and need help? Use the <a href="/support">support form</a>.</p>
      </div>

      <div class="con-map reveal">
        <iframe
          src={MAP_SRC}
          title="Keybridge IT, 75 King William Street, London EC4N 7BE"
          loading="lazy" referrerpolicy="no-referrer-when-downgrade" tabindex="-1"></iframe>
        <a class="con-map-link" href={MAP_LINK} target="_blank" rel="noopener noreferrer" aria-label="Open in Google Maps">
          <span class="con-map-cta">Open in Google Maps&nbsp;↗</span>
        </a>
      </div>

    </div>
  </section>
</Base>

<style>
  .con-hero{padding:130px 0 70px}
  /* desktop: intro + details on the left, tall map on the right, form full-width below */
  .con-grid{display:grid;grid-template-columns:1fr 1fr;column-gap:56px;row-gap:40px;align-items:start;
    grid-template-areas:"intro map" "details map" "form form"}
  .con-intro{grid-area:intro}
  .con-formblock{grid-area:form;margin-top:4px}
  .con-detailsblock{grid-area:details}
  .con-map{grid-area:map;align-self:stretch}

  .con-h1{font-size:clamp(40px,5vw,64px);line-height:1.02;margin-bottom:20px}
  .con-lead{color:var(--muted);font-size:18px;line-height:1.7;max-width:46ch;margin-bottom:0}
  .con-details > div{margin-bottom:16px;color:var(--muted);line-height:1.6}
  .con-label{display:block;font-family:var(--display, sans-serif);text-transform:uppercase;letter-spacing:.16em;font-size:11px;font-weight:700;color:var(--purple);margin-bottom:4px}
  .con-details a{color:#e7e7ee;text-decoration:none}
  .con-details a:hover{color:#fff}
  .con-aside{margin-top:22px;font-size:14px;color:var(--muted)}
  .con-aside a{color:var(--purple)}

  .con-form-h2{font-size:clamp(1.4rem,2.4vw,1.8rem);margin-bottom:24px}

  /* dark, non-interactive map with a subtle reveal (no zoom-on-hover) */
  .con-map{position:relative;aspect-ratio:1/1;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 24px 60px -34px rgba(0,0,0,.8)}
  .con-map iframe{position:absolute;inset:0;width:100%;height:100%;border:0;z-index:0;pointer-events:none;
    filter:invert(0.92) hue-rotate(180deg) brightness(0.9) contrast(0.92) saturate(0.85)}
  .con-map::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
    background:radial-gradient(120% 120% at 50% 40%, transparent 55%, rgba(10,7,16,.55));
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.03)}
  .con-map-link{position:absolute;inset:0;z-index:2;display:flex;align-items:flex-end;justify-content:flex-start;padding:14px;text-decoration:none;cursor:pointer}
  .con-map-cta{display:inline-flex;align-items:center;gap:6px;
    font-family:var(--display, sans-serif);font-size:13px;font-weight:600;color:#fff;
    background:rgba(8,6,12,.62);border:1px solid var(--line);backdrop-filter:blur(8px);
    padding:9px 15px;border-radius:999px;opacity:0;transform:translateY(8px);transition:opacity .28s ease, transform .28s ease}
  .con-map-link:hover .con-map-cta,.con-map-link:focus-visible .con-map-cta{opacity:1;transform:translateY(0)}

  /* mobile: heading + dot first (friendly), then form, then details, then map */
  @media(max-width:900px){
    .con-hero{padding:108px 0 40px}
    .con-grid{grid-template-columns:1fr;row-gap:32px;
      grid-template-areas:"intro" "form" "details" "map"}
    .con-map{aspect-ratio:4/3}
    .con-map-cta{opacity:1;transform:none}
  }
</style>
