---
import Base from "../layouts/Base.astro";
import ShieldViz from "../components/service/ShieldViz.astro";
import LockViz from "../components/service/LockViz.astro";
import Accreditations from "../components/shared/Accreditations.astro";
import Faq from "../components/Faq.astro";

const INFORCER_URL = "https://onboard-uk.inforcer.com/18a8d4be-72c4-41f2-ab55-b34a23d3a5e1";

const areas = [
  { ic: "ID", t: "Identity and access", d: "We look for issues involving administrator permissions, multi-factor authentication, user access and Conditional Access controls." },
  { ic: "EM", t: "Email and collaboration security", d: "We assess the protections surrounding Exchange Online, Microsoft Teams and SharePoint, including common phishing, malware and unsafe-link controls." },
  { ic: "DV", t: "Devices and endpoint protection", d: "Where applicable, we review the configuration of Microsoft Intune, device compliance and Microsoft Defender protections." },
  { ic: "DP", t: "Data protection and compliance", d: "We identify gaps in areas such as data-loss prevention, information protection, sensitivity labels and access to sensitive information." },
  { ic: "SB", t: "Security baselines", d: "Your tenant is assessed against recognised Microsoft 365 security practices to identify missing controls, configuration weaknesses and opportunities for improvement." },
  { ic: "LU", t: "Microsoft 365 licence utilisation", d: "We highlight useful security capabilities that may already be included in your existing Microsoft licences but are not currently being used." },
];

const reportItems = [
  "Your current Microsoft 365 security posture",
  "The most important risks and configuration gaps",
  "Areas where stronger controls are recommended",
  "Quick improvements that could reduce risk immediately",
  "Longer-term security priorities",
  "Microsoft 365 protections you may already be licensed to use",
  "Clear recommendations from the Keybridge team",
];

const steps = [
  { n: "01", t: "Connect your tenant securely", d: "Start the audit and sign in through Inforcer using your own Microsoft credentials. You do not send your password or login details to Keybridge. Someone with the appropriate Microsoft 365 administrator permissions will need to complete this step." },
  { n: "02", t: "Approve temporary read-only access", d: "You'll be shown the requested permissions before approving access. The connection provides read-only access for seven days. It allows us to assess your configuration but does not allow us to make changes to your Microsoft 365 environment." },
  { n: "03", t: "We run the assessment", d: "Keybridge uses Inforcer to assess the tenant's security configuration and identify gaps, risks and opportunities for improvement." },
  { n: "04", t: "Receive your report", d: "We prepare your security report and arrange a conversation to explain the findings, answer your questions and discuss the recommended priorities. There is no obligation to proceed with any further work." },
];

const reassure = [
  "You sign in directly with Microsoft",
  "Your password is not shared with Keybridge",
  "You see the requested permissions before approving them",
  "Access is read-only",
  "Keybridge cannot change your settings",
  "The connection is limited to seven days",
  "The audit does not interrupt your users or services",
  "There is no obligation to purchase anything",
];

const proposalPoints = [
  "Security risks that need immediate attention",
  "Work that should be included in your onboarding plan",
  "Existing tools or protections that are not being used effectively",
  "Opportunities to simplify your current security setup",
  "The areas Keybridge should prioritise if you decide to move forward",
];

const faqs = [
  { q: "Is the audit really free?", a: "Yes. There is no charge for the Microsoft 365 Security Audit and no obligation to purchase services from Keybridge." },
  { q: "Will Keybridge be able to change our settings?", a: "No. The audit uses read-only access. We can inspect the relevant configuration, but we cannot make changes to your Microsoft 365 tenant." },
  { q: "Do I need to give Keybridge my password?", a: "No. You sign in directly through Microsoft using Inforcer's secure onboarding process. Your Microsoft password is not shared with Keybridge." },
  { q: "How long does Keybridge have access?", a: "The connection is provided for seven days, giving us enough time to run the assessment and prepare your report." },
  { q: "Will the audit affect our users?", a: "No. The assessment is read-only and should not interrupt your users, email or other Microsoft 365 services." },
  { q: "Who should complete the connection?", a: "The process must be completed by someone with the appropriate Microsoft 365 administrator permissions. If another IT provider manages your tenant, you may need to ask them to complete or assist with this step." },
  { q: "What will the report show?", a: "The report will highlight your current security posture, configuration gaps, significant risks and recommended improvements. We'll help you distinguish between immediate quick wins and longer-term priorities." },
  { q: "Is this a penetration test?", a: "No. This is a configuration and security-posture assessment of your Microsoft 365 tenant. It does not attempt to exploit your systems and should not be presented as a penetration test." },
  { q: "What happens after the audit?", a: "Keybridge will talk you through the findings and answer your questions. You can then decide whether to address the recommendations internally, through your existing provider or with Keybridge." },
  { q: "What if we already have an IT provider?", a: "That is not a problem. The audit can provide an independent view of your Microsoft 365 security configuration and help you ask informed questions of your current provider." },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});
---
<Base
  title="Free Microsoft 365 Security Audit | Keybridge IT"
  description="Discover security gaps, configuration risks and missed protections in your Microsoft 365 tenant. Get a free, no-obligation security audit from Keybridge IT."
  image="/images/card-cyber-og.png"
>
  <script type="application/ld+json" set:html={faqSchema} is:inline></script>

  <!-- HERO -->
  <header class="aud-hero">
    <div class="grid-bg"></div>
    <div class="glow ag1"></div>
    <div class="glow ag2"></div>
    <div class="wrap aud-inner">
      <div class="aud-copy">
        <div class="eyebrow ah1"><span class="dot" style="background:var(--orange);box-shadow:0 0 12px var(--orange)"></span> FREE MICROSOFT 365 SECURITY AUDIT</div>
        <h1 class="ah2">Find the security gaps hiding in your <span class="hl">Microsoft 365 tenant</span></h1>
        <p class="lead ah3">Microsoft 365 includes powerful security controls, but they only protect your organisation when they are configured correctly. Our free tenant security audit gives you a clear picture of your current security posture, including configuration gaps, unnecessary risks and protections you may already be paying for but not using.</p>
        <p class="lead ah3" style="margin-top:14px">You'll receive a practical report showing what needs attention and what to prioritise first.</p>
        <div class="ah4" style="margin-top:38px">
          <button class="btn-primary audit-cta" data-cta="hero">Start your free security audit →</button>
          <p class="aud-smallprint">Free and without obligation. Read-only access for seven days. We cannot change your Microsoft 365 settings.</p>
        </div>
      </div>
      <div class="aud-viz ah3" aria-hidden="true"><ShieldViz accent="var(--orange)" /></div>
    </div>
    <!-- Trust bar -->
    <div class="aud-trust">
      <div class="wrap aud-trust-inner">
        <img src="/images/accreditations/ms-solutions-partner-white.png" alt="Microsoft Solutions Partner" />
        <img src="/images/accreditations/iso-27001.png" alt="ISO 27001:2022 certified" />
        <img src="/images/accreditations/cyber-essentials.png" alt="Cyber Essentials certified" />
        <span class="aud-stars"><span class="stars" aria-hidden="true">★★★★★</span> 130+ five-star Google reviews</span>
      </div>
    </div>
  </header>

  <!-- INTRODUCTION -->
  <section class="section">
    <div class="wrap intro-split">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:16px"><span class="dot" style="background:var(--orange);box-shadow:0 0 12px var(--orange)"></span> THE HONEST QUESTION</div>
        <h2 style="max-width:20ch;margin-bottom:24px">Do you know how securely your Microsoft 365 tenant is configured?</h2>
      </div>
      <div class="reveal intro-body">
        <p>Having Microsoft 365 does not automatically mean every available security feature is active or correctly configured.</p>
        <p>Multi-factor authentication may not cover every account. Administrators may have more access than they need. Email protection, Conditional Access, device security and data-protection controls may be incomplete or still using default settings.</p>
        <p>These gaps are difficult to spot without examining the tenant itself.</p>
        <p style="color:var(--ink);font-weight:500">The Keybridge Microsoft 365 Security Audit provides an evidence-based view of your configuration, without making any changes to your environment.</p>
      </div>
    </div>
  </section>

  <!-- WHAT THE AUDIT EXAMINES -->
  <section class="section sec-tint2">
    <div class="wrap">
      <div class="eyebrow reveal" style="margin-bottom:16px"><span class="dot" style="background:var(--orange);box-shadow:0 0 12px var(--orange)"></span> WHAT THE AUDIT EXAMINES</div>
      <h2 class="reveal" style="max-width:22ch;margin-bottom:40px">A practical assessment of your Microsoft 365 security</h2>
      <div class="grid-3">
        {areas.map((c, i) => (
          <article class={`card reveal ${["v-orange","v-purple","v-teal","v-lime","v-orange","v-purple"][i]}`}>
            <div class="bartop"></div>
            <div class="ic">{c.ic}</div>
            <h3>{c.t}</h3><p>{c.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT YOU RECEIVE -->
  <section class="section sec-band sec-tint">
    <div class="band-glow" style="background:var(--orange);left:-120px;top:50%;transform:translateY(-50%)"></div>
    <div class="wrap report-split">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:16px"><span class="dot" style="background:var(--orange);box-shadow:0 0 12px var(--orange)"></span> WHAT YOU RECEIVE</div>
        <h2 style="max-width:16ch;margin-bottom:24px">Your results, explained clearly</h2>
        <p style="color:var(--muted);line-height:1.75;margin-bottom:18px">After completing the audit, you'll receive a security report covering everything on the right.</p>
        <p style="color:var(--muted);line-height:1.75;margin-bottom:18px">We'll talk you through the findings in plain English so you understand what matters, why it matters and what your options are.</p>
        <p style="color:var(--ink);line-height:1.6;font-weight:500">The report is yours to keep, whether or not you decide to work with Keybridge.</p>
      </div>
      <ul class="report-list reveal">
        {reportItems.map((r) => (
          <li><span class="tick" aria-hidden="true">✓</span>{r}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="wrap">
      <div class="eyebrow reveal" style="margin-bottom:16px"><span class="dot" style="background:var(--orange);box-shadow:0 0 12px var(--orange)"></span> HOW IT WORKS</div>
      <h2 class="reveal" style="max-width:20ch;margin-bottom:40px">A secure, straightforward process</h2>
      <div class="steps">
        {steps.map((s) => (
          <article class="step reveal">
            <span class="step-num">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </article>
        ))}
      </div>
      <div class="reveal" style="margin-top:40px;text-align:center">
        <button class="btn-primary audit-cta" data-cta="how-it-works">Connect your Microsoft 365 tenant securely →</button>
        <p class="aud-smallprint" style="margin-top:14px">Secure onboarding is provided through Inforcer.</p>
      </div>
    </div>
  </section>

  <!-- REASSURANCE -->
  <section class="section sec-band sec-tint">
    <div class="band-glow" style="background:var(--orange);right:-120px;top:50%;transform:translateY(-50%)"></div>
    <div class="wrap feat-row">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:16px"><span class="dot" style="background:var(--orange);box-shadow:0 0 12px var(--orange)"></span> YOU STAY IN CONTROL</div>
        <h2 style="max-width:20ch;margin-bottom:22px">Your Microsoft 365 environment remains under your control</h2>
        <p style="color:var(--muted);line-height:1.75;margin-bottom:26px">We understand that granting access to your Microsoft 365 tenant is a significant decision. That is why the audit uses a controlled, time-limited process:</p>
        <ul class="assure-list">
          {reassure.map((r) => (
            <li><span class="tick" aria-hidden="true">✓</span>{r}</li>
          ))}
        </ul>
        <button class="btn-primary audit-cta" data-cta="reassurance" style="margin-top:32px">Start the secure connection →</button>
      </div>
      <div class="reveal viz-wrap"><LockViz accent="var(--orange)" /></div>
    </div>
  </section>

  <!-- WHY KEYBRIDGE -->
  <section class="section">
    <div class="wrap why-split">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:16px"><span class="dot" style="background:var(--orange);box-shadow:0 0 12px var(--orange)"></span> WHY KEYBRIDGE</div>
        <h2 style="max-width:18ch;margin-bottom:24px">Security expertise you can trust</h2>
        <p style="font-family:var(--display);font-size:clamp(1.2rem,2vw,1.6rem);line-height:1.4;color:var(--ink)">We don't just produce a list of technical findings. We help you understand their business impact and decide what should happen next.</p>
      </div>
      <div class="reveal">
        <p style="color:var(--muted);line-height:1.75;margin-bottom:18px">Keybridge supports more than 200 organisations and manages thousands of devices across the UK. Our team combines practical Microsoft 365 experience with recognised security credentials: ISO 27001:2022 certification, Cyber Essentials certification, Microsoft Solutions Partner status and more than 130 five-star Google reviews.</p>
        <p style="color:var(--muted);line-height:1.75;margin-bottom:28px">We have direct experience supporting organisations in recruitment, legal, accountancy, financial services and the charity sector.</p>
        <Accreditations />
      </div>
    </div>
  </section>

  <!-- PROPOSAL SECTION -->
  <section class="section sec-tint2">
    <div class="wrap prop-split">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:16px"><span class="dot" style="background:var(--orange);box-shadow:0 0 12px var(--orange)"></span> ALREADY TALKING TO US?</div>
        <h2 style="max-width:20ch;margin-bottom:24px">Recently received a proposal from Keybridge?</h2>
        <p style="color:var(--muted);line-height:1.75">If you are currently considering a Keybridge proposal, the audit gives both teams a clearer, evidence-based view of your Microsoft 365 environment. The audit is free and does not commit you to accepting our proposal.</p>
      </div>
      <ul class="report-list reveal">
        {proposalPoints.map((r) => (
          <li><span class="tick" aria-hidden="true">✓</span>{r}</li>
        ))}
      </ul>
    </div>
  </section>

  <Faq items={faqs} accent="var(--orange)" />

  <!-- FINAL CTA -->
  <section class="ctaband" style="--ac:var(--orange)">
    <div class="glow cg" style="width:600px;height:600px;background:var(--orange);left:50%;top:50%;transform:translate(-50%,-50%);opacity:.16"></div>
    <div class="wrap cinner reveal" style="position:relative;z-index:2;text-align:center;padding-block:clamp(70px,9vw,110px);max-width:760px">
      <h2>Get a clearer view of your Microsoft 365 security</h2>
      <p class="lead" style="margin:20px auto 34px">Find out where your organisation is well protected, where gaps exist and what you should prioritise next. The audit is free, read-only and without obligation.</p>
      <button class="btn-primary audit-cta" data-cta="final">Start your free Microsoft 365 security audit →</button>
      <p class="aud-smallprint" style="margin-top:16px">You will be transferred to Inforcer to complete the secure Microsoft 365 connection.</p>
      <p class="aud-footnote">By starting the audit, you will be transferred to Inforcer's secure onboarding service and asked to authenticate directly with Microsoft. Please review the permissions displayed by Microsoft before approving access.<br /><a href="/privacy">Keybridge privacy notice</a> · <a href="https://inforcer.com/privacy-policy/" target="_blank" rel="noopener noreferrer">Inforcer privacy notice</a> · <a href="/contact">Contact Keybridge</a></p>
    </div>
  </section>

  <!-- LEAD CAPTURE MODAL -->
  <dialog id="auditModal" class="aud-modal" aria-labelledby="auditModalTitle">
    <form id="auditForm" method="dialog" novalidate>
      <button type="button" class="am-close" id="auditModalClose" aria-label="Close">&times;</button>
      <div class="eyebrow" style="margin-bottom:12px"><span class="dot" style="background:var(--orange);box-shadow:0 0 12px var(--orange)"></span> ONE QUICK STEP</div>
      <h3 id="auditModalTitle">Where should we send your report?</h3>
      <p class="am-sub">Tell us who the audit is for, then we'll take you straight to the secure Microsoft connection.</p>
      <input type="text" name="cf_hp_check" tabindex="-1" autocomplete="off" class="am-hp" aria-hidden="true" />
      <label>Name
        <input type="text" name="name" id="amName" autocomplete="name" required minlength="2" placeholder="Your name" />
      </label>
      <label>Work email
        <input type="email" name="email" id="amEmail" autocomplete="email" required placeholder="you@company.co.uk" />
      </label>
      <label>Company
        <input type="text" name="company" id="amCompany" autocomplete="organization" required minlength="2" placeholder="Company name" />
      </label>
      <p class="am-error" id="amError" hidden>Please fill in all three fields with valid details.</p>
      <button type="submit" class="btn-primary am-submit" id="amSubmit">Continue to the secure connection →</button>
      <p class="am-note">You'll authenticate directly with Microsoft via Inforcer. Your password is never shared with Keybridge. We'll use these details to send your report and follow up on your audit. <a href="/privacy">Privacy notice</a>.</p>
    </form>
  </dialog>
</Base>

<style>
  /* Hero */
  .aud-hero{position:relative;overflow:hidden;display:flex;flex-direction:column;min-height:92svh;padding-top:120px}
  .ag1{width:560px;height:560px;background:var(--orange);top:-160px;left:-80px;opacity:.2}
  .ag2{width:480px;height:480px;background:var(--purple);bottom:-180px;right:-60px;opacity:.16}
  .aud-inner{position:relative;z-index:2;flex:1 1 auto;display:grid;grid-template-columns:1.15fr .85fr;gap:50px;align-items:center;width:100%}
  .aud-copy h1{max-width:22ch;margin:22px 0 24px;font-size:clamp(2.2rem,3.6vw,3.6rem);line-height:1.06}
  .aud-copy .hl{color:var(--orange)}
  .aud-copy .lead{max-width:56ch}
  .aud-viz{display:flex;justify-content:center}
  .aud-smallprint{margin-top:14px;font-size:13.5px;color:var(--muted2);line-height:1.6;max-width:52ch}

  @keyframes audRise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
  html.js .ah1{opacity:0;animation:audRise .7s .04s cubic-bezier(.2,.7,.2,1) both}
  html.js .ah2{opacity:0;animation:audRise .8s .16s cubic-bezier(.2,.7,.2,1) both}
  html.js .ah3{opacity:0;animation:audRise .8s .34s cubic-bezier(.2,.7,.2,1) both}
  html.js .ah4{opacity:0;animation:audRise .8s .5s cubic-bezier(.2,.7,.2,1) both}
  @media(prefers-reduced-motion:reduce){html.js .ah1,html.js .ah2,html.js .ah3,html.js .ah4{opacity:1;animation:none}}

  .aud-trust{position:relative;z-index:2;flex:0 0 auto;border-block:1px solid var(--line);background:rgba(255,255,255,.015);margin-top:46px}
  .aud-trust-inner{display:flex;align-items:center;gap:clamp(24px,4vw,52px);flex-wrap:wrap;padding-block:16px}
  .aud-trust-inner img{height:38px;width:auto}
  .aud-trust-inner img[alt^="ISO"]{height:44px}
  .aud-trust-inner img[alt^="Cyber"]{height:44px}
  .aud-stars{font-size:14px;color:var(--muted);display:inline-flex;align-items:center;gap:8px}
  .stars{color:#f5b301;letter-spacing:2px;font-size:13px}

  /* Sections */
  .intro-split{display:grid;grid-template-columns:1fr 1.2fr;gap:60px;align-items:start}
  .intro-body p{color:var(--muted);line-height:1.75;margin-bottom:18px}
  .report-split,.prop-split{display:grid;grid-template-columns:1fr 1.1fr;gap:60px;align-items:center}
  .why-split{display:grid;grid-template-columns:1fr 1.1fr;gap:60px;align-items:start}
  .feat-row{display:grid;grid-template-columns:1.15fr .85fr;gap:60px;align-items:center}
  .viz-wrap{display:flex;justify-content:center}

  .report-list{list-style:none;display:grid;gap:12px}
  .report-list li{display:flex;gap:14px;align-items:flex-start;color:var(--ink);line-height:1.6;
    border:1px solid var(--line);border-radius:12px;padding:14px 18px;
    background:linear-gradient(180deg,rgba(255,255,255,.025),rgba(255,255,255,0))}
  .assure-list{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:10px 26px}
  .assure-list li{display:flex;gap:10px;align-items:flex-start;color:var(--muted);line-height:1.55;font-size:15px;padding:6px 0}
  .tick{color:var(--orange);font-weight:700;flex:0 0 auto}

  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
  .step{position:relative;border:1px solid var(--line);border-radius:var(--radius);padding:30px 26px;
    background:linear-gradient(180deg,rgba(255,255,255,.025),rgba(255,255,255,0));transition:border-color .3s,transform .3s}
  .step:hover{border-color:rgba(232,132,43,.5);transform:translateY(-4px)}
  .step-num{font-family:var(--display);font-size:13px;letter-spacing:.1em;color:var(--orange)}
  .step h3{font-size:1.15rem;margin:12px 0 12px}
  .step p{color:var(--muted);font-size:14.5px;line-height:1.65}

  .ctaband{position:relative;overflow:hidden;border-top:1px solid var(--line);background:linear-gradient(180deg,var(--bg),var(--bg2))}
  .aud-footnote{margin-top:34px;font-size:12.5px;color:var(--muted2);line-height:1.7;max-width:64ch;margin-inline:auto}
  .aud-footnote a{color:var(--muted);text-decoration:underline;text-underline-offset:3px}
  .aud-footnote a:hover{color:var(--ink)}

  /* Modal */
  .aud-modal{
    margin:auto;width:min(480px,92vw);border:1px solid var(--line-strong);border-radius:18px;
    background:linear-gradient(180deg,#17141d,#0e0c12);color:var(--ink);padding:38px 34px 30px;
    box-shadow:0 40px 120px -20px rgba(0,0,0,.8);
  }
  .aud-modal::backdrop{background:rgba(5,4,8,.72);backdrop-filter:blur(6px)}
  .aud-modal h3{font-size:1.6rem;margin-bottom:10px}
  .am-sub{color:var(--muted);line-height:1.6;font-size:14.5px;margin-bottom:22px}
  .aud-modal label{display:block;font-family:var(--display);font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
  .aud-modal input{
    display:block;width:100%;margin-top:6px;padding:12px 14px;border-radius:10px;
    border:1px solid var(--line-strong);background:rgba(255,255,255,.04);color:var(--ink);
    font-family:var(--body);font-size:15px;transition:border-color .2s;
  }
  .aud-modal input:focus{outline:none;border-color:var(--orange)}
  .aud-modal input.bad{border-color:#e0566b}
  .am-hp{position:absolute;left:-9999px;top:-9999px}
  .am-error{color:#e0566b;font-size:13.5px;margin:-4px 0 12px}
  .am-submit{width:100%;justify-content:center;margin-top:6px}
  .am-note{margin-top:16px;font-size:12px;color:var(--muted2);line-height:1.6}
  .am-note a{color:var(--muted);text-decoration:underline;text-underline-offset:2px}
  .am-close{position:absolute;top:14px;right:14px;background:none;border:1px solid var(--line);color:var(--ink);
    width:34px;height:34px;border-radius:9px;font-size:19px;line-height:1;cursor:pointer;transition:background .2s}
  .am-close:hover{background:rgba(255,255,255,.07)}
  .aud-modal form{position:relative}

  @media(max-width:980px){
    .aud-inner{grid-template-columns:1fr;gap:26px}
    .aud-viz{display:none}
    .aud-hero{min-height:0;padding-top:130px}
  }
  @media(max-width:900px){
    .intro-split,.report-split,.prop-split,.why-split,.feat-row{grid-template-columns:1fr;gap:30px}
    .steps{grid-template-columns:1fr}
    .assure-list{grid-template-columns:1fr}
  }
  @media(max-width:1100px) and (min-width:901px){
    .steps{grid-template-columns:repeat(2,1fr)}
  }
</style>

<script define:vars={{ INFORCER_URL }}>
  const modal = document.getElementById("auditModal");
  const form = document.getElementById("auditForm");
  const err = document.getElementById("amError");
  const submitBtn = document.getElementById("amSubmit");
  const fields = {
    name: document.getElementById("amName"),
    email: document.getElementById("amEmail"),
    company: document.getElementById("amCompany"),
  };
  const track = (event, cta) => {
    try { window.gtag && gtag("event", event, { cta: cta || "" }); } catch (e) {}
  };

  document.querySelectorAll(".audit-cta").forEach((btn) => {
    btn.addEventListener("click", () => {
      track("audit_modal_open", btn.dataset.cta);
      modal.showModal();
      fields.name.focus();
    });
  });
  document.getElementById("auditModalClose").addEventListener("click", () => modal.close());
  modal.addEventListener("click", (e) => { if (e.target === modal) modal.close(); });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const name = fields.name.value.trim();
    const email = fields.email.value.trim();
    const company = fields.company.value.trim();
    const emailOk = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email);
    let bad = false;
    for (const [k, el] of Object.entries(fields)) {
      const ok = k === "email" ? emailOk : el.value.trim().length >= 2;
      el.classList.toggle("bad", !ok);
      if (!ok) bad = true;
    }
    if (bad) { err.hidden = false; return; }
    err.hidden = true;
    submitBtn.disabled = true;
    submitBtn.textContent = "Opening the secure connection…";
    track("audit_lead_submitted");

    // Capture the lead, but never block the funnel: 4s cap, then redirect regardless.
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 4000);
    try {
      await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        signal: controller.signal,
        body: JSON.stringify({
          subject: "Free M365 Security Audit — new lead",
          name, email, company,
          reason: "Started the free Microsoft 365 Security Audit",
          message: `${name} (${company}) started the free Microsoft 365 Security Audit and was passed to Inforcer to connect their tenant. Follow up if the connection doesn't complete.`,
          source: "audit-landing-page",
          cf_hp_check: "",
        }),
      });
    } catch (e) { /* lead capture is best-effort */ }
    clearTimeout(timer);
    window.location.href = INFORCER_URL;
  });
</script>
