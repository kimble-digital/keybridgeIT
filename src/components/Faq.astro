---
interface FaqItem { q: string; a: string }
interface Props { items: FaqItem[]; title?: string; accent?: string }
const { items, title = "Frequently asked questions", accent = "var(--purple)" } = Astro.props;
---
<section class="section faqs" style={`--ac:${accent}`}>
  <div class="wrap">
    <h2 class="reveal" style="margin-bottom:40px">{title}</h2>
    <div class="faqlist">
      {items.map((it) => (
        <details class="faq reveal">
          <summary>{it.q}<span class="plus">+</span></summary>
          <div class="ans"><p>{it.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faqlist{border-top:1px solid var(--line)}
  .faq{border-bottom:1px solid var(--line)}
  .faq summary{
    list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;
    padding:24px 0;font-family:var(--display);font-weight:600;font-size:1.12rem;transition:color .2s;
  }
  .faq summary::-webkit-details-marker{display:none}
  .faq summary:hover{color:var(--ac)}
  .plus{font-size:1.5rem;color:var(--ac);transition:transform .3s;flex:0 0 auto}
  .faq[open] .plus{transform:rotate(45deg)}
  .ans{padding:0 0 26px;color:var(--muted);max-width:70ch;line-height:1.7}
</style>
