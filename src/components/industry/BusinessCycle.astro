---
// New-business cycle — ring of numbered stages with arrows + a glowing dot
// travelling the loop. Adapted from OrbitViz. Pure SVG + CSS.
//
// Edit `stages` to reorder/rename. `highlight` is the index to emphasise
// (your key metric — 1st interviews). Colours come from CSS vars with
// fallbacks, so it inherits your brand if those tokens exist.
interface Props {
  stages?: string[];
  centre?: string;
  highlight?: number;       // index of the stage to emphasise (0-based)
  accent?: string;          // dark teal (rings, dark nodes, dot)
  accentSoft?: string;      // light teal (alternate nodes)
  ink?: string;             // label text colour (dark-on-light by default)
}
const {
  stages = ["Calls", "Client meetings", "Jobs", "Candidate meetings", "1st interviews", "Candidate flips"],
  centre = "New business",
  highlight = 4,
  accent = "var(--teal, #1f6b7a)",
  accentSoft = "var(--teal-soft, #8fb8c2)",
  ink = "var(--light-ink, #20343a)",
} = Astro.props;

const W = 760, H = 560;
const cx = 380, cy = 280, r = 188;          // ring
const nr = 30;                               // node radius
const lr = r + 52;                           // label radius
const gap = 0.34;                            // arrow gap (rad) either side of a node
const N = stages.length;
const ang = (i: number) => (i / N) * Math.PI * 2 - Math.PI / 2;

const nodes = stages.map((label, i) => {
  const a = ang(i);
  const x = cx + r * Math.cos(a);
  const y = cy + r * Math.sin(a);
  const lx = cx + lr * Math.cos(a);
  const ly = cy + lr * Math.sin(a);
  const anchor = Math.cos(a) > 0.25 ? "start" : Math.cos(a) < -0.25 ? "end" : "middle";
  const dy = Math.sin(a) < -0.3 ? -6 : Math.sin(a) > 0.3 ? 16 : 5;
  return { label, i, x, y, lx, ly, anchor, dy, dark: i % 2 === 1 };
});

const arrows = stages.map((_, i) => {
  const a1 = ang(i) + gap, a2 = ang((i + 1) % N) - gap;
  const x1 = cx + r * Math.cos(a1), y1 = cy + r * Math.sin(a1);
  const x2 = cx + r * Math.cos(a2), y2 = cy + r * Math.sin(a2);
  return `M${x1.toFixed(1)} ${y1.toFixed(1)} A ${r} ${r} 0 0 1 ${x2.toFixed(1)} ${y2.toFixed(1)}`;
});

const centreLines = centre.split(" ");
const ringPath = `M ${cx} ${cy - r} A ${r} ${r} 0 1 1 ${cx - 0.01} ${cy - r}`; // full circle for the dot
---
<div class="bizcycle" style={`--ac:${accent};--ac2:${accentSoft};--ink:${ink}`}>
  <svg viewBox={`0 0 ${W} ${H}`} fill="none" xmlns="http://www.w3.org/2000/svg" role="img"
       aria-label={`${centre} cycle: ${stages.join(", ")}`}>
    <defs>
      <marker id="bcArrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--ac)" stroke-opacity=".5" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </marker>
      <filter id="bcGlow" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="4" result="b"/>
        <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>

    <!-- arrows between stages -->
    {arrows.map((d) => (
      <path d={d} stroke="var(--ac)" stroke-opacity=".5" stroke-width="2" fill="none" marker-end="url(#bcArrow)"/>
    ))}

    <!-- travelling dot -->
    <circle r="7" fill="var(--ac)" filter="url(#bcGlow)" class="dot">
      <animateMotion dur="16s" repeatCount="indefinite" rotate="auto" path={ringPath}/>
    </circle>

    <!-- centre -->
    <circle cx={cx} cy={cy} r="82" fill="var(--ac)" fill-opacity=".08" stroke="var(--ac)" stroke-width="2.5"/>
    <text x={cx} y={cy - (centreLines.length > 1 ? 8 : -6)} text-anchor="middle"
          font-family="var(--display, sans-serif)" font-weight="700" font-size="22" fill="var(--ac)">
      {centreLines.map((w, i) => (
        <tspan x={cx} dy={i === 0 ? 0 : 26}>{w}</tspan>
      ))}
    </text>

    <!-- nodes -->
    {nodes.map((n) => (
      <g class={n.i === highlight ? "node hot" : "node"}>
        {n.i === highlight && (
          <circle cx={n.x} cy={n.y} r={nr + 7} fill="none" stroke="var(--ac)" stroke-opacity=".55" stroke-width="2" class="halo"/>
        )}
        <circle cx={n.x} cy={n.y} r={nr} fill={n.dark ? "var(--ac)" : "var(--ac2)"}/>
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-family="var(--display, sans-serif)"
              font-weight="700" font-size="18" fill="#fff">{n.i + 1}</text>
        <text x={n.lx} y={n.ly + n.dy} text-anchor={n.anchor} font-family="var(--display, sans-serif)"
              font-weight="600" font-size="16" fill="var(--ink)">{n.label}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .bizcycle{width:100%;max-width:680px;margin:0 auto}
  .bizcycle svg{width:100%;height:auto;overflow:visible}
  .dot{opacity:.95}
  .hot .halo{animation:bcHalo 2.6s ease-in-out infinite;transform-origin:center}
  @keyframes bcHalo{0%,100%{stroke-opacity:.25}50%{stroke-opacity:.7}}
  @media(prefers-reduced-motion:reduce){
    .dot animateMotion{display:none}
    .hot .halo{animation:none}
  }
</style>
