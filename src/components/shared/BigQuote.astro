---
interface Props {
  quote: string;
  name: string;
  role?: string;
  accent?: string;
}
const { quote, name, role, accent = "var(--teal)" } = Astro.props;
---
<section class="bigquote" style={`--ac:${accent}`}>
  <div class="glow bq-glow"></div>
  <div class="wrap bq-inner reveal">
    <span class="mark">“</span>
    <blockquote>{quote}</blockquote>
    <div class="attr">
      <span class="bar"></span>
      <div>
        <strong>{name}</strong>
        {role && <span class="role">{role}</span>}
      </div>
    </div>
  </div>
</section>
<style>
  .bigquote{position:relative;overflow:hidden;padding-block:clamp(70px,10vw,130px)}
  .bq-glow{width:560px;height:560px;background:var(--ac);left:50%;top:0;transform:translate(-50%,-40%);opacity:.12}
  .bq-inner{position:relative;z-index:2;max-width:980px;text-align:center}
  .mark{font-family:var(--display);font-size:5rem;line-height:0;color:var(--ac);display:inline-block;margin-bottom:10px;opacity:.8}
  blockquote{font-family:var(--display);font-weight:600;font-size:clamp(1.5rem,3.4vw,2.6rem);line-height:1.25;letter-spacing:-.01em;margin-bottom:36px}
  .attr{display:inline-flex;align-items:center;gap:16px}
  .attr .bar{width:34px;height:2px;background:var(--ac)}
  .attr strong{font-family:var(--display);font-size:1rem;display:block}
  .attr .role{color:var(--muted);font-size:14px}
</style>
