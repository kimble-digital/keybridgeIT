---
import { stats } from "../data/site";

// Hero background image (drop the file in public/images/).
const heroBg = "/images/ai-bloke.png";
---
<header class="hero">
  <div class="hero-bg" style={`background-image:url('${heroBg}')`}></div>
  <div class="hero-shade"></div>

  <div class="wrap hero-inner">
    <div class="hero-left">
      <div class="eyebrow hb"><span class="dot"></span> AI &nbsp;|&nbsp; CYBER &nbsp;|&nbsp; SUPPORT</div>
      <h1>
        <span class="line"><span data-w>Secure IT.</span></span>
        <span class="line"><span data-w>Protected <span class="accent">data.</span></span></span>
        <span class="line"><span data-w>Smarter ways</span></span>
        <span class="line"><span data-w>to <span class="rotator" id="rot">operate</span>.</span></span>
      </h1>
      <p class="lead hsub">
        We help <b>recruitment agencies, law firms and accountancy practices</b> keep their technology secure,
        teams productive and businesses moving forward.
      </p>
      <div class="cta-row hcta">
        <a href="/it-review" class="btn-primary">Book a Free IT Review →</a>
        <a href="#services" class="btn-ghost">See how we work</a>
      </div>
    </div>
  </div>

  <div class="ticker-wrap">
    <div class="ticker" id="ticker">
      {[0,1].map(() => stats.map((s) => (
        <span class="item"><span class="bdot" style={`background:${s.color}`}></span>{s.value} <small>{s.label}</small></span>
      )))}
    </div>
  </div>
</header>

<style>
  .hero{min-height:100svh;display:flex;flex-direction:column;padding:96px 0 0;position:relative;overflow:hidden;background:#06080c}

  /* ---- background image + shading ---- */
  .hero-bg{
    position:absolute;inset:0;z-index:0;
    background-position:center right;background-size:cover;background-repeat:no-repeat;
    transform:scale(1.04);will-change:transform;
  }
  .hero-shade{
    position:absolute;inset:0;z-index:1;pointer-events:none;
    background:
      linear-gradient(90deg, rgba(6,8,12,.95) 0%, rgba(6,8,12,.82) 34%, rgba(6,8,12,.42) 64%, rgba(6,8,12,.62) 100%),
      linear-gradient(0deg, rgba(6,8,12,.9) 0%, rgba(6,8,12,0) 42%),
      radial-gradient(120% 90% at 20% 30%, rgba(101,39,102,.18), transparent 60%);
  }

  .hero-inner{position:relative;z-index:2;width:100%;flex:1 1 auto;display:flex;align-items:center}
  .hero-left{display:flex;flex-direction:column;justify-content:center;max-width:62ch}
  h1{margin-bottom:22px;max-width:16ch;line-height:1.02;font-size:clamp(42px,5.6vw,74px)}
  .line{display:block;overflow:hidden}
  .line span[data-w]{display:inline-block;will-change:transform}
  .line.revealed{overflow:visible}
  .rotator{position:relative;display:inline-block;color:var(--lime)}
  .hsub{max-width:52ch;margin-bottom:38px}
  .cta-row{display:flex;gap:16px;flex-wrap:wrap;align-items:center}
  .hb{margin-bottom:28px;opacity:0}

  @media(min-width:1040px){
    .hero-left{max-width:none;width:58%}
  }

  /* on narrow screens push the image so the person stays in frame, and darken a touch more */
  @media(max-width:820px){
    .hero-bg{background-position:72% center}
    .hero-shade{background:
      linear-gradient(0deg, rgba(6,8,12,.94) 8%, rgba(6,8,12,.55) 55%, rgba(6,8,12,.7) 100%);}
  }

  .ticker-wrap{position:relative;z-index:2;margin-top:40px;flex:0 0 auto;border-block:1px solid var(--line);overflow:hidden;background:rgba(6,8,12,.45);backdrop-filter:blur(2px)}
  .ticker{display:flex;white-space:nowrap;will-change:transform}
  .ticker .item{display:inline-flex;align-items:center;gap:14px;padding:18px 38px;font-family:var(--display);font-weight:600;font-size:15px;border-right:1px solid var(--line)}
  .ticker .item small{color:var(--muted);font-weight:400;font-family:var(--body)}
  .ticker .item .bdot{width:6px;height:6px;border-radius:50%}
</style>

<script is:inline>
  window.addEventListener('load', () => {
    if (!window.gsap) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const words = gsap.utils.toArray('[data-w]');

    if (reduce) {
      gsap.set(words, { yPercent: 0 });
      document.querySelector('.hb').style.opacity = 1;
      document.querySelectorAll('.line').forEach(l => l.classList.add('revealed'));
    } else {
      gsap.set(words, { yPercent: 115 });
      const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
      tl.to('.hb', { opacity: 1, duration: .6 }, 0)
        .to(words, { yPercent: 0, duration: 1.1, stagger: .09, onComplete: () => {
          document.querySelectorAll('.line').forEach(l => l.classList.add('revealed'));
        } }, .1)
        .from('.hsub', { opacity: 0, y: 20, duration: .8 }, '-=.6')
        .from('.hcta', { opacity: 0, y: 20, duration: .7 }, '-=.5')
        .from('.hero-bg', { opacity: 0, scale: 1.12, duration: 1.6, ease: 'power2.out' }, 0);

      // word rotator
      const rotWords = ['operate','grow','automate','win'];
      const rotColors = ['var(--lime)','var(--teal)','#f5c542','var(--orange)'];
      let ri = 0;
      const rot = document.getElementById('rot');
      setInterval(() => {
        ri = (ri + 1) % rotWords.length;
        gsap.to(rot, { yPercent: -100, opacity: 0, duration: .32, ease: 'power2.in', onComplete: () => {
          rot.textContent = rotWords[ri];
          rot.style.color = rotColors[ri];
          gsap.fromTo(rot, { yPercent: 100, opacity: 0 }, { yPercent: 0, opacity: 1, duration: .4, ease: 'power2.out' });
        }});
      }, 2200);

      // ticker marquee
      gsap.to('#ticker', { xPercent: -50, duration: 26, ease: 'none', repeat: -1 });
    }
  });
</script>
