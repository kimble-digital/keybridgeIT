---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import AuditBanner from "../components/AuditBanner.astro";
import Footer from "../components/Footer.astro";
import { company } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = "Keybridge IT — Secure IT. Protected data. Smarter ways of working.",
  description = "Managed IT, cyber security and AI for recruitment agencies, law firms and accountancy practices. One accountable partner. 15 years. 200 organisations.",
  // Site-wide default OG image (homepage card). Pages override via the `image` prop.
  image = "/images/card-home-og.png",
} = Astro.props;

// og:image / twitter:image must be ABSOLUTE URLs. Resolve against your
// configured `site` (astro.config.mjs); fall back to the live domain.
const siteOrigin = Astro.site ?? new URL("https://www.keybridgeit.com/");
const ogImage = new URL(image, siteOrigin).href;
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4RWE6905RW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4RWE6905RW');
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "yiped8o2d6");
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Keybridge IT" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <AuditBanner />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- GSAP for kinetic + scroll animation (islands only need this once) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>
    <script is:inline>
      (function () {
        function showAll() {
          document.querySelectorAll('.reveal').forEach(function (el) {
            el.style.opacity = 1; el.style.transform = 'none';
          });
        }

        // This script sits directly AFTER the synchronous GSAP <script> tags at
        // the end of <body>, so GSAP and the full DOM are already available the
        // moment it runs. We therefore animate immediately, NOT on window.load
        // (which waits for the hero image and caused the reveal-then-reflash).
        function run() {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!window.gsap || reduce) { showAll(); return; }
          gsap.registerPlugin(ScrollTrigger);

          gsap.utils.toArray('.reveal').forEach(function (el) {
            var r = el.getBoundingClientRect();
            var inView = r.top < window.innerHeight * 0.92;
            if (inView) {
              // Already visible on load, animate in immediately, no scroll needed.
              gsap.fromTo(el, { opacity: 0, y: 28 },
                { opacity: 1, y: 0, duration: .8, ease: 'power3.out' });
            } else {
              gsap.fromTo(el, { opacity: 0, y: 28 },
                { opacity: 1, y: 0, duration: .8, ease: 'power3.out',
                  scrollTrigger: { trigger: el, start: 'top 88%' } });
            }
          });
          ScrollTrigger.refresh();
        }

        // GSAP loaded synchronously above, but guard anyway: if for any reason
        // it isn't ready yet, retry briefly, then hard-reveal so nothing is
        // ever stuck hidden. No window.load, no long race against the image.
        if (window.gsap) { run(); return; }
        var n = 0;
        var t = setInterval(function () {
          if (window.gsap || n++ > 40) { clearInterval(t); run(); }
        }, 25);
      })();
    </script>
  </body>
</html>
